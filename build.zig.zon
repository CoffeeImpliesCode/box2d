// SPDX-License-Identifier: MIT
.{
    .name = .box2d,
    // Matches the upstream C library version in CMakeLists.txt and b2GetVersion.
    .version = "3.1.1",
    .fingerprint = 0xbbd8fcbdd2e75550,
    .minimum_zig_version = "0.16.0",
    // No package dependencies; source code and enkiTS are local.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build_support",
        // Cross-platform profile discovered by cross-test.
        "cross-test.profile.sh",
        // Zig facade and translated header.
        "zig",
        // Upstream C sources and headers.
        "include",
        "src",
        // Upstream support library and tests.
        "shared",
        "test",
        // Upstream benchmark tool.
        "benchmark",
        // Vendored enkiTS sources and licence.
        "extern/enkiTS",
        "tests.zig",
        "smoke.zig",
        // Separate consumer package for module import checks.
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Licence and package provenance files.
        "LICENSE",
        "README.md",
        "README.upstream.md",
        "UPSTREAM.md",
        "README.zig.md",
        "NOTICE.md",
        "CHANGELOG.md",
        "FORK-NOTES.md",
        "FORK-LICENSE.md",
        // Repository integrity record for upstream files.
        "UPSTREAM.sha256",
        // Runtime dispatch modules used by box2d.
        "runtime",
        // Nix packaging and development-shell files.
        // The lockfile matches the flake input and travels with it.
        "package.nix",
        "flake.nix",
        "flake.lock",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
    },
}
