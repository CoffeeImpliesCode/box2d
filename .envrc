# SPDX-License-Identifier: MIT
#
# .envrc — load this SDK's development shell with direnv.
#
# `use devenv` is the whole interface: direnv hands the directory to the devenv
# binary, which reads `devenv.yaml`, `devenv.nix` and the driver's `devenv.lock`
# from it. No flag, no path and no store path belongs here — the current shell
# CLI has no `--dotfile` option, so there is nothing to pass.
#
# What this file does add is scratch policy, resolved at load time on the host
# that loads it. It names no host, no account, no mount and no store path.

if ! declare -F use >/dev/null 2>&1; then
  echo "box2d: direnv is not on PATH; enter this shell with 'devenv shell' instead." >&2
  return 1
fi

# This workspace's storage policy chooses an approved writable mount and exports
# HOST_SCRATCH_ROOT. On a host without it, nothing below is set and nothing is
# faked: the toolchain's own defaults stay in place and their absence is visible.
# `$HOME` is read at load time, so this is a host fact rather than a path written
# into a committed file.
if [ -z "${HOST_SCRATCH_ROOT:-}" ] && [ -r "$HOME/.local/lib/host-scratch.sh" ]; then
  # shellcheck disable=SC1090  # resolved here, at load time, on this host
  . "$HOME/.local/lib/host-scratch.sh"
fi

if [ -n "${HOST_SCRATCH_ROOT:-}" ]; then
  # `devenv` reads DEVENV_HOME for its own state and XDG_RUNTIME_DIR for the base
  # of its runtime sockets; without the latter it falls back to /tmp even when
  # TMPDIR points at approved storage. Both are exported here so every process
  # this directory starts inherits them.
  export DEVENV_HOME="${HOST_SCRATCH_ROOT}/devenv-home/box2d"
  export XDG_DATA_HOME="${HOST_SCRATCH_ROOT}/devenv-data"
  export XDG_RUNTIME_DIR="${HOST_SCRATCH_ROOT}/devenv-run"
  mkdir -p "$DEVENV_HOME" "$XDG_DATA_HOME" "$XDG_RUNTIME_DIR"
fi

use devenv